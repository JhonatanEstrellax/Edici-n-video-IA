    "assets_dir": "assets/mascotamas",
    "logo_original": "assets/mascotamas/logo.png",
    "peeking_creature_bottom_left": true
  },
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "codec": "libx264",
    "crf": 18,
    "preset": "medium",
    "pixel_format": "yuv420p",
    "desktop_tutorial_mode": "1920x1080_fullscreen_dock"
  },
  "cuts": {
    "keep_only_corrected_script_words": true,
    "max_sentence_pause_sec": 0.15,
    "word_padding_before_sec": 0.05,
    "word_padding_after_sec": 0.05,
    "audio_crossfade_ms": 10,
    "min_segment_duration_sec": 0.12,
    "discard_non_speech_under_sec": 0.6,
    "voice_onset_trim_threshold_db": -38.0,
    "retake_policy": {
      "prefer_later_takes": true,
      "require_looking_at_camera": true,
      "prefer_higher_volume": true,
      "reject_whispering": true
    },
    "intro_start_at_first_word": true,
    "outro_tail_after_last_word_sec": 0.3
  },
  "audio": {
    "target_lufs": -14.0,
    "true_peak_dbtp": -1.0,
    "denoise_and_enhance_voice": {
      "enabled": true,
      "highpass_hz": 90,
      "afftdn_nr_db": 20,
      "afftdn_nf_db": -28,
      "presence_boost_db": 5.0,
      "air_boost_db": 3.5,
      "compressor_ratio": 3.2,
      "compressor_makeup_db": 5.0
    },
    "voice_leveling": {
      "enabled": true,
      "max_boost_db": 6.0,
      "max_cut_db": -3.0
    },
    "bgm": {
      "enabled": true,
      "folder": "bgm",
      "relative_to_voice_db": -13.5,
      "ducking_extra_db": -6.0,
      "fade_in_sec": 0.3,
      "fade_out_sec": 0.8
    },
    "sfx": {
      "enabled": true,
      "folder": "sfx",
      "lead_time_sec": 0.05,
      "min_interval_sec": 1.2,
      "volume_db": -12.0,
      "types": {
        "scene_change": "whoosh.wav",
        "emphasis_bounce": "pop.wav",
        "cta_title": "ding.wav"
      }
    },
    "voice_mode": "studio_clean_v2_and_argentine_neural_v3"
  },
  "camera": {
    "full_screen_only": true,
    "center_face": true,
    "cut_zoom_start": 1.0,
    "cut_zoom_end": 1.02,
    "emphasis_zoom": 1.1,
    "split_graphic_vert_anchor": 0.255,
    "split_graphic_min_y1_ratio": 0.0
